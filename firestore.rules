rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-isolated namespace: strictly authorized to owner only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Explicit fallback: reject any unmapped path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User root document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // AYRA AI conversations
    match /users/{userId}/ayraConversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User private journals
    match /users/{userId}/journals/{journalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Profile subcollection (About Me, Bucket List, Trackers)
    match /users/{userId}/profile/{profileId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Periodic Reflections (Weekly, Monthly, Yearly)
    match /users/{userId}/weeklyReflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/monthlyReflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/yearlyReflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contextual Reflections (Diary & Globe)
    match /users/{userId}/diaryReflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/globeReflections/{reflectionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // General conversations
    match /users/{userId}/conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny-by-default for any unmapped paths or top-level collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


